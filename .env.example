# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# URL publique de l'app. En local : http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# Clé service_role : SERVEUR UNIQUEMENT. Ne jamais préfixer NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ---------------------------------------------------------------------------
# Fournisseur IA
# ---------------------------------------------------------------------------
# mock = parcours complet sans un euro d'API. fal = fal.ai.
AI_PROVIDER=mock
FAL_KEY=
# Modèle image-to-image utilisé par FalProvider.
FAL_MODEL=fal-ai/flux/dev/image-to-image
# Secret partagé vérifiant les webhooks du fournisseur IA.
AI_WEBHOOK_SECRET=change-me-in-production

# ---------------------------------------------------------------------------
# Garde-fous de dépense (section 7.4) — obligatoires
# ---------------------------------------------------------------------------
# Nombre maximum de générations sur l'ensemble du service, par jour.
DAILY_GENERATION_CAP=40
# Coût estimé d'une génération, en centimes. Sert au suivi de daily_spend.
ESTIMATED_COST_CENTS_PER_GENERATION=4
# Générations par utilisateur et par heure.
USER_HOURLY_GENERATION_LIMIT=5
# Générations gratuites par adresse IP et par 24 h.
IP_FREE_GENERATION_LIMIT=3

# ---------------------------------------------------------------------------
# Stripe (mode test)
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Prix Stripe : paiement unique (pack) et abonnement (pass mensuel).
STRIPE_PRICE_PACK=price_...
STRIPE_PRICE_PASS=price_...

# ---------------------------------------------------------------------------
# Resend — mocké tant que la clé est absente (log console)
# ---------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=Trycut <bonjour@example.com>

# ---------------------------------------------------------------------------
# PostHog
# ---------------------------------------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# ---------------------------------------------------------------------------
# Cron Vercel (purge J+30)
# ---------------------------------------------------------------------------
CRON_SECRET=change-me-in-production
