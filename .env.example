# ---------------------------------------------------------------- application
# Sur Vercel, laisser vide : l'URL du déploiement (VERCEL_URL) est utilisée.
# À renseigner dès qu'un nom de domaine est branché.
NEXT_PUBLIC_SITE_URL=

# ------------------------------------------------------------------- Supabase
# Dashboard Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé service_role : SERVEUR UNIQUEMENT, jamais exposée au navigateur.
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------- fournisseur IA
# mock = parcours complet sans un euro d'API. fal = fal.ai.
AI_PROVIDER=mock
FAL_KEY=
# Secret partagé vérifié par /api/webhooks/ai. À changer en production.
AI_WEBHOOK_SECRET=change-moi

# --------------------------------------------------------- plafonds de dépense
DAILY_GENERATION_CAP=15
MONTHLY_SPEND_CAP_CENTS=1800
COST_PER_GENERATION_CENTS=4

# --------------------------------------------------------------------- Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PACK=
STRIPE_PRICE_PASS=
STRIPE_PRICE_PACK_ONESHOT=
# Liens de paiement Stripe (publics). Surchargent ceux codés dans lib/pricing.ts.
NEXT_PUBLIC_STRIPE_LINK_PACK=
NEXT_PUBLIC_STRIPE_LINK_PASS=

# ---------------------------------------------------------------------- Resend
# Absente : sendEmail() log en console au lieu d'envoyer.
RESEND_API_KEY=
EMAIL_FROM=Trycut <bonjour@trycut.io>

# -------------------------------------------------------------------- PostHog
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# ----------------------------------------------------------------- flags & cron
# none (défaut) = aucune question, on va droit à l'import photo.
# short = 4 écrans, full = 13 écrans.
NEXT_PUBLIC_ONBOARDING_LENGTH=none

# L'offre gratuite donne 0 coupe : l'essai anonyme est coupé par défaut.
ENABLE_FREE_TRIAL=false
# Protège /api/cron/cleanup. Vercel envoie `Authorization: Bearer $CRON_SECRET`.
CRON_SECRET=
# Signe le jeton d'essai anonyme httpOnly. À changer en production.
ANON_TOKEN_SECRET=change-moi
